# Generated outputs stay out of git; each study's README says how to rebuild
# them and where the copy its report was built from is kept.
*.npz
*.npy
*.html
# ...except the liver cell viewer's page, which is source, not output.
!gtex-liver-viewer/static/*.html
# Temporary files of the atomic writes (e.g. results/bars/<slide>.npz.tmp) after an interrupted run.
*.tmp
logs/
figures/
superseded/

__pycache__/
.DS_Store
.venv/

# A study's pinned clone of a third party's repository is data, fetched at its
# pinned commit by the study's script (betti-fpca-regression-benchmark/fetch_upstream.py).
upstream/
